# ─── İL & AY Pərdə & Jalüz ERP ────────────────────────────────────────────────
# Hazırlanma: cehizlik-pos monorepo (Next.js 14 + Express + Prisma + SQLite)

# ─── Verilənlər bazası (SQLite - işə başlamaq üçün) ───────────────────────────
DATABASE_URL="file:./dev.db"

# ─── JWT Sirlər (mütləq dəyişdirin!) ─────────────────────────────────────────
JWT_ACCESS_SECRET=ilay-access-secret-min-32-chars-change-in-prod
JWT_REFRESH_SECRET=ilay-refresh-secret-min-32-chars-change-in-prod

# ─── API (Express) ─────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ─── Web (Next.js) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Mağaza parametrləri ──────────────────────────────────────────────────────
STORE_NAME="İL & AY"
STORE_SUBTITLE="Pərdə & Jalüz mağazası · Mingəçevir"
