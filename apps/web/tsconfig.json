{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "incremental": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@cehizlik/types": [
        "packages/types/src"
      ],
      "@cehizlik/utils": [
        "packages/utils/src"
      ],
      "@cehizlik/config": [
        "packages/config/src"
      ],
      "@cehizlik/ui": [
        "packages/ui/src"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
